@inproceedings{srivastava_application_1990,
	title = {An {Application} of {Geostatistical} {Methods} for {Risk} {Analysis} in {Reservoir} {Management}},
	url = {https://doi.org/10.2118/20608-MS},
	doi = {10.2118/20608-MS},
	abstract = {A case study is presented of risk analysis for a reservoir in which gas injection is used to enhance oil recovery. Geostatistics is used to build a procedure for addressing the question of how much gas should be injected. Through the use of indicator simulation, this procedure incorporates not only the quantitative in. procedure incorporates not only the quantitative in. formation available from well logs, but also the qualitative information available from a geologic model of the reservoir. The use of loss functions enables the decision-maker to incorporate the economic parameters that affect the enhanced oil recovery procedure. parameters that affect the enhanced oil recovery procedure.The injection of solvent in a miscible flood process requires an estimate of the connected pore process requires an estimate of the connected pore volume through which the solvent can sweep as is passes from an injection well to a production well. Traditional methods for estimating this connected pore volume have three important shortcomings:1. They typically underestimate the complexity of the reservoir between wells by assuming that permeable horizons continue in a planar fashion all the way to the next well or, for those horizons that do not correlate, that they pinch out conveniently half way between the wells.2. They tackle the problem in 2D sections by considering separately each injector/producer pair within a particular pattern, thereby ignoring the important possibility of 3D flow.3. They do not quantify the uncertainty associated with the estimate and do not provide any possibility for assessing the impact of this inevitable uncertainty.By ignoring the irregularities in the reservoir lithology, the first of these shortcomings typically causes the connected pore volume to be overestimated; by ignoring flow paths in the third dimension, the second shortcoming typically causes it to be underestimated. As will be shown later, by ignoring the economic aspects of the problem, the third shortcoming likely results in further underestimation of the connected pore volume. whether the various underestimations and overestimations compensate each other is quite unclear. It would be useful to have a methodology that avoids some or all of these shortcomings. Though it may, in the final analysis, yield answers that are very similar to those obtained by a careful application of the traditional methodology, it would do so without depending on one mistake to cancel the effects of another. This paper presents a case study from a real reservoir of a geostatistical approach to the problem of estimating the connected pore volume. The method of indicator simulation is used to produce realizations of the sandstone/shale sequence within a meander-belt environment. Each realization provides one possible version of the reservoir lithology for a particular injector/producer pattern from which the connected pore volume can be calculated. When several realizations are combined, the result is a probability distribution of connected pore volume.P. 825},
	urldate = {2022-05-30},
	author = {Srivastava, R.M.},
	month = sep,
	year = {1990},
	pages = {SPE--20608--MS},
}

