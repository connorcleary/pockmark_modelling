@article{zamrsky_global_2024,
	title = {Global {Impact} of {Sea} {Level} {Rise} on {Coastal} {Fresh} {Groundwater} {Resources}},
	volume = {12},
	issn = {2328-4277, 2328-4277},
	url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2023EF003581},
	doi = {10.1029/2023EF003581},
	abstract = {Groundwater is the main freshwater source in many densely populated and industrialized coastal areas around the world. Growing future freshwater demand is likely to increase the water stress in these coastal areas, possibly leading to groundwater overexploitation and salinization. This situation will likely be aggravated by climate change and the associated projected sea level rise. Here, we assess the impact of sea level rise exclusively on coastal fresh groundwater resources worldwide (limited to areas with unconsolidated sedimentary systems) by estimating future decline in inland fresh groundwater volumes under three sea level rise scenarios following Representative Concentration Pathway (RCP) 2.6, 4.5, and 8.5. For that, 2D groundwater models in 1,200 coastal regions estimate the past, present and future groundwater salinity. Our results show that roughly 60 (range 16–96) million people living within 10 km from current coastline could lose more than 5\% of their fresh groundwater resources by 2100 according to RCP 8.5 scenario compared to only 8 (range 0–50) million people based on RCP 2.6 scenario. We conclude that sea level rise will have severe consequences for many coastal populations heavily dependent on fresh groundwater.},
	language = {en},
	number = {1},
	urldate = {2024-12-15},
	journal = {Earth's Future},
	author = {Zamrsky, Daniel and Oude Essink, Gualbert H. P. and Bierkens, Marc F. P.},
	month = jan,
	year = {2024},
	pages = {e2023EF003581},
}

@article{jasechko_groundwater_2020,
	title = {Groundwater level observations in 250,000 coastal {US} wells reveal scope of potential seawater intrusion},
	volume = {11},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-020-17038-2},
	doi = {10.1038/s41467-020-17038-2},
	abstract = {Abstract
            Seawater intrusion into coastal aquifers can increase groundwater salinity beyond potable levels, endangering access to freshwater for millions of people. Seawater intrusion is particularly likely where water tables lie below sea level, but can also arise from groundwater pumping in some coastal aquifers with water tables above sea level. Nevertheless, no nation-wide, observation-based assessment of the scope of potential seawater intrusion exists. Here we compile and analyze {\textasciitilde}250,000 coastal groundwater-level observations made since the year 2000 in the contiguous United States. We show that the majority of observed groundwater levels lie below sea level along more than 15\% of the contiguous coastline. We conclude that landward hydraulic gradients characterize a substantial fraction of the East Coast ({\textgreater}18\%) and Gulf Coast ({\textgreater}17\%), and also parts of the West Coast where groundwater pumping is high. Sea level rise, coastal land subsidence, and increasing water demands will exacerbate the threat of seawater intrusion.},
	language = {en},
	number = {1},
	urldate = {2024-12-15},
	journal = {Nature Communications},
	author = {Jasechko, Scott and Perrone, Debra and Seybold, Hansjörg and Fan, Ying and Kirchner, James W.},
	month = jun,
	year = {2020},
	pages = {3229},
}

